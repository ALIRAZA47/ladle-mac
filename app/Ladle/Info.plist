<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Ladle</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Ladle</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>

	<!-- Files Ladle saves get the quarantine flag, like a browser's downloads, so Gatekeeper checks apps. -->
	<key>LSFileQuarantineEnabled</key>
	<true/>
	<!-- Downloads come from any site, including plain http. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Ladle saves your downloads in your Downloads folder.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>Ladle saves downloads to the folder you choose.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Ladle saves downloads to the folder you choose.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>Ladle saves downloads to the folder you choose.</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>Ladle saves downloads to the folder you choose.</string>

	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>me.alirazakhan.Ladle</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ladle</string>
			</array>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Web Location</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>None</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.apple.web-internet-location</string>
			</array>
		</dict>
	</array>

	<!-- Sparkle 2 (SPEC "Updates"). The release workflow refuses to ship the placeholder key. -->
	<key>SUFeedURL</key>
	<string>https://ladle.alirazakhan.me/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>KHEwBrneF/Lth44nE+Tr7rTvjAJ1g4513i5UQmPPFoQ=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>SUEnableSystemProfiling</key>
	<false/>
</dict>
</plist>
