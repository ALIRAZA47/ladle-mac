---
import { getEntry } from 'astro:content';
import Icon from '../Icon.astro';
import { docsSections, topicCards, hrefFor } from '../../config/docs-nav.mjs';

const cards = await Promise.all(
	topicCards.map(async (card) => {
		const slugs = docsSections
			.filter((section) => card.sections.includes(section.id))
			.flatMap((section) => section.pages.map((page) => page.slug));
		const links = await Promise.all(
			slugs.map(async (slug) => {
				const entry = await getEntry('docs', slug);
				if (!entry) throw new Error(`Docs page not found: ${slug}`);
				return { href: hrefFor(slug), title: entry.data.title };
			})
		);
		return { ...card, links };
	})
);
---

<section class="topics not-content" aria-labelledby="topics-title">
	<h2 id="topics-title">Browse by topic</h2>
	<div class="grid">
		{
			cards.map((card) => (
				<section id={card.id} class="card" aria-labelledby={`${card.id}-title`}>
					<div class="head">
						<span class="icon" aria-hidden="true">
							<Icon name={card.icon as 'start'} size={19} />
						</span>
						<h3 id={`${card.id}-title`}>{card.title}</h3>
					</div>
					<ul>
						{card.links.map((link) => (
							<li>
								<a href={link.href}>
									<Icon name="doc" size={14} class="doc-icon" />
									{link.title}
								</a>
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>
</section>

<style>
	.topics {
		padding: 16px 0 64px;
	}
	h2 {
		margin: 0 0 16px;
		font-family: var(--ld-font-body);
		font-size: 20px;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--ld-text);
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
		gap: 16px;
	}
	.card {
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding: 24px;
		border-radius: 24px;
		background: var(--ld-card);
		border: 1px solid var(--ld-line);
		box-shadow: inset 0 1px 0 var(--ld-hi), var(--ld-shadow-card);
		scroll-margin-top: calc(var(--sl-nav-height) + 24px);
	}
	.card:target {
		border-color: var(--ld-tint-ring);
		box-shadow:
			inset 0 0 0 1px var(--ld-tint-ring),
			var(--ld-shadow-card);
	}
	.head {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.icon {
		width: 40px;
		height: 40px;
		display: grid;
		place-items: center;
		border-radius: 13px;
		background: var(--ld-tint);
		color: var(--ld-ink-strong);
	}
	h3 {
		margin: 0;
		font-family: var(--ld-font-body);
		font-size: 18px;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--ld-text);
	}
	ul {
		display: flex;
		flex-direction: column;
		gap: 4px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		margin: 0;
	}
	a {
		display: flex;
		align-items: center;
		gap: 8px;
		min-height: 30px;
		font-size: 15px;
		color: var(--ld-text2);
		text-decoration: none;
		border-radius: 8px;
	}
	a:hover {
		color: var(--ld-text);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	a :global(.doc-icon) {
		color: var(--ld-text3);
	}
</style>
