---
import Icon from '../Icon.astro';

const steps = [
	{
		href: '/docs/getting-started/install/',
		title: 'Install Ladle',
		text: 'Drag Ladle to Applications and open it once. Its Safari extension comes along with it.',
		time: '2 min',
	},
	{
		href: '/docs/getting-started/set-up-your-browser/',
		title: 'Set up your browser',
		text: 'Turn on the extension, and clicking a download in your browser hands it straight to Ladle.',
		time: '3 min',
	},
	{
		href: '/docs/getting-started/first-download/',
		title: 'Your first download',
		text: 'Paste a link in the bar at the top, press Download now and watch it pour.',
		time: '1 min',
	},
];
---

<section class="start not-content" aria-labelledby="start-title">
	<h2 id="start-title">Start here</h2>
	<ol>
		{
			steps.map((step, i) => (
				<li>
					<a class="card" href={step.href}>
						<span class="num" aria-hidden="true">
							{i + 1}
						</span>
						<span class="title">{step.title}</span>
						<span class="text">{step.text}</span>
						<span class="time">
							<Icon name="clock" size={13} />
							{step.time}
						</span>
					</a>
				</li>
			))
		}
	</ol>
</section>

<style>
	.start {
		padding-bottom: 48px;
	}
	h2 {
		margin: 0 0 16px;
		font-family: var(--ld-font-body);
		font-size: 20px;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--ld-text);
	}
	ol {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
		gap: 16px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		margin: 0;
		display: flex;
	}
	.card {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 22px;
		border-radius: 24px;
		background: var(--ld-card);
		border: 1px solid var(--ld-line);
		box-shadow: inset 0 1px 0 var(--ld-hi), var(--ld-shadow-card);
		color: var(--ld-text);
		text-decoration: none;
		transition:
			background-color 0.15s,
			border-color 0.15s;
	}
	.card:hover {
		background: var(--ld-card-hover);
		border-color: var(--ld-line2);
	}
	.num {
		width: 32px;
		height: 32px;
		display: grid;
		place-items: center;
		border-radius: 999px;
		background: var(--ld-tint);
		font-family: var(--ld-font-display);
		font-size: 16px;
		font-weight: 800;
		color: var(--ld-ink-strong);
	}
	.title {
		font-size: 18px;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.text {
		font-size: 14.5px;
		line-height: 1.55;
		color: var(--ld-text2);
	}
	.time {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: auto;
		font-size: 13px;
		color: var(--ld-text3);
	}
</style>
