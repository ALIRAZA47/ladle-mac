---
import Icon from '../Icon.astro';
import { SUPPORT_URL } from '../../config/site.mjs';
---

<section id="support" class="support not-content" aria-labelledby="support-title">
	<div class="band">
		<span class="icon" aria-hidden="true"><Icon name="chat" size={24} /></span>
		<div class="copy">
			<h2 id="support-title">Still stuck?</h2>
			<p>
				Ask on GitHub Issues and describe what happened. Include your Ladle version from{' '}
				<strong>Ladle › About Ladle</strong>. Issues are public, so leave out private links.
			</p>
		</div>
		<a class="button" href={SUPPORT_URL}>
			Open GitHub Issues
			<Icon name="external" size={15} />
		</a>
	</div>
</section>

<style>
	.support {
		padding-bottom: 32px;
		scroll-margin-top: calc(var(--sl-nav-height) + 24px);
	}
	.band {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 20px 28px;
		padding: 28px 30px;
		border-radius: 28px;
		background: var(--ld-card);
		border: 1px solid var(--ld-line);
		box-shadow: inset 0 1px 0 var(--ld-hi), var(--ld-shadow-card);
	}
	.icon {
		width: 52px;
		height: 52px;
		flex: none;
		display: grid;
		place-items: center;
		border-radius: 16px;
		background: var(--ld-tint);
		color: var(--ld-ink-strong);
	}
	.copy {
		flex: 1 1 320px;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	h2 {
		margin: 0;
		font-family: var(--ld-font-body);
		font-size: 20px;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--ld-text);
	}
	p {
		margin: 0;
		font-size: 15px;
		line-height: 1.55;
		color: var(--ld-text2);
	}
	strong {
		color: var(--ld-text);
		font-weight: 600;
	}
	.button {
		height: 44px;
		padding: 0 20px;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		border-radius: 999px;
		background: var(--ld-btn-ghost);
		border: 1px solid var(--ld-line2);
		box-shadow: inset 0 1px 0 var(--ld-hi);
		color: var(--ld-text);
		font-size: 14.5px;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}
	.button:hover {
		background: var(--ld-btn-ghost-hover);
	}
</style>
