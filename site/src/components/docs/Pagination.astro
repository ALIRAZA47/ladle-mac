---
const { prev, next } = Astro.locals.starlightRoute.pagination;
---

{
	(prev || next) && (
		<nav aria-label="More guides" class="pager" data-pagefind-ignore>
			{prev ? (
				<a href={prev.href} rel="prev" class="card">
					<span class="dir">← Previous</span>
					<span class="label">{prev.label}</span>
				</a>
			) : (
				<span class="spacer" />
			)}
			{next && (
				<a href={next.href} rel="next" class="card next">
					<span class="dir">Next →</span>
					<span class="label">{next.label}</span>
				</a>
			)}
		</nav>
	)
}

<style>
	.pager {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
		gap: 12px;
	}
	.card {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 16px 20px;
		border-radius: 20px;
		background: var(--ld-card);
		border: 1px solid var(--ld-line);
		box-shadow: inset 0 1px 0 var(--ld-hi), var(--ld-shadow-card);
		color: var(--ld-text);
		text-decoration: none;
		transition:
			background-color 0.15s,
			border-color 0.15s;
	}
	.card:hover {
		background: var(--ld-card-hover);
		border-color: var(--ld-line2);
	}
	.next {
		align-items: flex-end;
		text-align: end;
	}
	.dir {
		font-size: 13px;
		color: var(--ld-text3);
	}
	.label {
		font-size: 16px;
		font-weight: 600;
		line-height: 1.35;
	}
	@media (max-width: 600px) {
		.spacer {
			display: none;
		}
	}
</style>
