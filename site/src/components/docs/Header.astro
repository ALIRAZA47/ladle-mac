---
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from './SiteTitle.astro';
import ThemeToggle from '../ThemeToggle.astro';
import Icon from '../Icon.astro';
import { docsLinks } from './links.mjs';

const isDocsHome = Astro.url.pathname === '/docs/';
---

<div class="docs-header">
	<div class="title-wrap">
		<SiteTitle />
	</div>
	<div class="search-wrap print:hidden">
		<Search />
	</div>
	<nav aria-label="Docs" class="links print:hidden">
		{
			docsLinks.map((link) => (
				<a
					href={link.href}
					class:list={{ active: link.id === 'guides' }}
					aria-current={link.id === 'guides' && isDocsHome ? 'page' : undefined}
				>
					{link.label}
				</a>
			))
		}
	</nav>
	<div class="right print:hidden">
		<ThemeToggle />
		<a class="download" href="/download/">
			<Icon name="download" size={14} strokeWidth={2.3} />
			Download
		</a>
	</div>
</div>

<style>
	.docs-header {
		height: 100%;
		display: flex;
		align-items: center;
		gap: 12px 22px;
		max-width: 1360px;
		margin-inline: auto;
	}
	.title-wrap {
		display: flex;
		min-width: 0;
		/* Keep the focus ring around the title link visible. */
		padding: 0.25rem;
		margin: -0.25rem;
	}
	.search-wrap {
		display: flex;
		flex: 1 1 260px;
		max-width: 420px;
		min-width: 0;
	}
	.links {
		margin-inline-start: auto;
		display: flex;
		align-items: center;
		gap: 4px 20px;
		font-size: 14px;
		font-weight: 500;
	}
	.links a {
		color: var(--ld-text2);
		text-decoration: none;
		border-radius: 8px;
		padding: 4px 2px;
	}
	.links a:hover,
	.links a.active {
		color: var(--ld-text);
	}
	.right {
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.download {
		height: 38px;
		padding: 0 16px;
		display: inline-flex;
		align-items: center;
		gap: 7px;
		border-radius: 999px;
		background: var(--ld-accent);
		color: var(--ld-on-accent);
		font-size: 13.5px;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.35),
			0 8px 22px rgba(255, 138, 31, 0.28);
	}
	.download:hover {
		filter: brightness(1.07);
	}

	@media (max-width: 49.99rem) {
		.docs-header {
			gap: 8px;
		}
		.search-wrap {
			flex: 0 0 auto;
			margin-inline-start: auto;
		}
		.links,
		.download {
			display: none;
		}
	}
	@media (min-width: 50rem) and (max-width: 66rem) {
		.links {
			display: none;
		}
		.right {
			margin-inline-start: auto;
		}
	}
</style>
