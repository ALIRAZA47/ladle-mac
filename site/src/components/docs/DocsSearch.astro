---
/**
 * The big search box on the docs home. It queries the same Pagefind index as the header search
 * and lists matching guides as you type. Without JavaScript it falls back to the header search.
 */
import Icon from '../Icon.astro';
import { docsSections, hrefFor } from '../../config/docs-nav.mjs';

const sections = Object.fromEntries(
	docsSections.flatMap((section) => section.pages.map(({ slug }) => [hrefFor(slug), section.label]))
);
---

<div class="docs-search" data-docs-search data-sections={JSON.stringify(sections)}>
	<form class="field" role="search" action="/docs/" data-form>
		<Icon name="search" size={19} class="field-icon" />
		<label for="docs-search-input" class="sr-only">Search the docs</label>
		<input
			id="docs-search-input"
			type="search"
			name="q"
			placeholder="Try “resume a failed download”"
			autocomplete="off"
			spellcheck="false"
			aria-controls="docs-search-results"
			aria-describedby="docs-search-status"
		/>
	</form>
	<div class="results" id="docs-search-results" data-results hidden>
		<ul data-list></ul>
		<p class="empty" data-empty hidden>
			No guides match “<span data-query></span>”. Try fewer words, or <a href="/docs/#support">ask for help</a>.
		</p>
		<p class="empty" data-unavailable hidden>
			Search works on the published site. Run <code>npm run build</code> and <code>npm run preview</code> to try it.
		</p>
	</div>
	<p class="sr-only" id="docs-search-status" role="status" data-status></p>
</div>

<script>
	type Result = { url: string; meta: { title?: string } };
	type Pagefind = {
		init: () => Promise<void> | void;
		debouncedSearch: (q: string, opts?: object, ms?: number) => Promise<null | { results: { data: () => Promise<Result> }[] }>;
	};

	const root = document.querySelector<HTMLElement>('[data-docs-search]');
	if (root) {
		const input = root.querySelector<HTMLInputElement>('input')!;
		const form = root.querySelector<HTMLFormElement>('[data-form]')!;
		const panel = root.querySelector<HTMLElement>('[data-results]')!;
		const list = root.querySelector<HTMLUListElement>('[data-list]')!;
		const empty = root.querySelector<HTMLElement>('[data-empty]')!;
		const unavailable = root.querySelector<HTMLElement>('[data-unavailable]')!;
		const status = root.querySelector<HTMLElement>('[data-status]')!;
		const sections: Record<string, string> = JSON.parse(root.dataset.sections || '{}');
		let pagefind: Pagefind | null = null;
		let loading: Promise<Pagefind | null> | null = null;

		const load = () => {
			loading ??= import(/* @vite-ignore */ `${'/pagefind/pagefind.js'}`)
				.then(async (mod: Pagefind) => {
					await mod.init();
					pagefind = mod;
					return mod;
				})
				.catch(() => null);
			return loading;
		};

		const links = () => [...list.querySelectorAll<HTMLAnchorElement>('a')];
		const close = () => {
			panel.hidden = true;
			input.setAttribute('aria-expanded', 'false');
		};
		const open = () => {
			panel.hidden = false;
			input.setAttribute('aria-expanded', 'true');
		};

		async function run() {
			const query = input.value.trim();
			if (!query) {
				list.replaceChildren();
				status.textContent = '';
				close();
				return;
			}
			const pf = pagefind ?? (await load());
			if (!pf) {
				unavailable.hidden = false;
				open();
				return;
			}
			const search = await pf.debouncedSearch(query, {}, 120);
			if (search === null || query !== input.value.trim()) return;
			const results = await Promise.all(search.results.slice(0, 6).map((r) => r.data()));
			list.replaceChildren(
				...results.map((result) => {
					const li = document.createElement('li');
					const a = document.createElement('a');
					a.href = result.url;
					const title = document.createElement('span');
					title.className = 'r-title';
					title.textContent = result.meta.title || result.url;
					const section = document.createElement('span');
					section.className = 'r-section';
					section.textContent = sections[new URL(result.url, location.href).pathname] || 'Ladle Docs';
					a.append(title, section);
					li.append(a);
					return li;
				})
			);
			empty.hidden = results.length > 0;
			root!.querySelector('[data-query]')!.textContent = query;
			status.textContent =
				results.length === 0 ? 'No guides found.' : `${results.length} guide${results.length === 1 ? '' : 's'} found.`;
			open();
		}

		input.addEventListener('focus', () => void load(), { once: true });
		input.addEventListener('input', () => void run());
		form.addEventListener('submit', (event) => {
			event.preventDefault();
			links()[0]?.click();
		});
		input.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowDown' && !panel.hidden) {
				event.preventDefault();
				links()[0]?.focus();
			} else if (event.key === 'Escape') {
				if (!panel.hidden) event.preventDefault();
				close();
			}
		});
		list.addEventListener('keydown', (event) => {
			const all = links();
			const index = all.indexOf(document.activeElement as HTMLAnchorElement);
			if (event.key === 'ArrowDown') {
				event.preventDefault();
				all[Math.min(index + 1, all.length - 1)]?.focus();
			} else if (event.key === 'ArrowUp') {
				event.preventDefault();
				(index <= 0 ? input : all[index - 1]).focus();
			} else if (event.key === 'Escape') {
				close();
				input.focus();
			}
		});
		root.addEventListener('focusout', (event) => {
			if (!root.contains(event.relatedTarget as Node | null)) close();
		});
		input.addEventListener('click', () => {
			if (input.value.trim() && list.childElementCount + (empty.hidden ? 0 : 1) > 0) open();
		});
	}
</script>

<style>
	.docs-search {
		position: relative;
		width: min(640px, 100%);
		margin-top: 14px;
		text-align: start;
	}
	.field {
		display: flex;
		align-items: center;
		gap: 10px;
		height: 58px;
		padding: 0 20px;
		border-radius: 999px;
		background: var(--ld-card);
		border: 1px solid var(--ld-line2);
		box-shadow: inset 0 1px 0 var(--ld-hi), var(--ld-shadow-card);
	}
	.field:focus-within {
		box-shadow: 0 0 0 2px var(--ld-focus);
	}
	.field :global(.field-icon) {
		color: var(--ld-ink);
	}
	input {
		flex: 1;
		min-width: 0;
		height: 50px;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--ld-text);
		font: inherit;
		font-size: 16px;
	}
	input:focus,
	input:focus-visible {
		outline: none;
	}
	input::placeholder {
		color: var(--ld-text3);
		opacity: 1;
	}
	input::-webkit-search-cancel-button {
		cursor: pointer;
	}
	.results {
		position: absolute;
		z-index: 20;
		top: 66px;
		left: 0;
		right: 0;
		padding: 8px;
		border-radius: 22px;
		background: var(--ld-pop);
		border: 1px solid var(--ld-line2);
		box-shadow: var(--ld-shadow-pop);
		-webkit-backdrop-filter: blur(24px);
		backdrop-filter: blur(24px);
	}
	.results[hidden] {
		display: none;
	}
	ul {
		display: flex;
		flex-direction: column;
		gap: 2px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	ul :global(a) {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 10px 14px;
		border-radius: 14px;
		color: var(--ld-text);
		text-decoration: none;
	}
	ul :global(a:hover),
	ul :global(a:focus-visible) {
		background: var(--ld-tint);
		outline-offset: -2px;
	}
	ul :global(.r-title) {
		font-size: 14.5px;
		font-weight: 600;
	}
	ul :global(.r-section) {
		font-size: 12.5px;
		color: var(--ld-text3);
	}
	.empty {
		margin: 0;
		padding: 12px 14px;
		font-size: 14px;
		color: var(--ld-text2);
	}
	.empty code {
		font-size: 0.9em;
	}
	.empty a {
		color: var(--ld-ink);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
